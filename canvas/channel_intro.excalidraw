   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Not the notation. The missing WHY.\nWhy was this introduced? What was broken before it?\nThat context existed somewhere \u2014 just never next to the thing\nI was reading.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not the notation. The missing WHY.\nWhy was this introduced? What was broken before it?\nThat context existed somewhere \u2014 just never next to the thing\nI was reading.",
