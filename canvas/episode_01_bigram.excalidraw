   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "\u2212 log(0)  =  \u221e",
   "fontSize": 34,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2212 log(0)  =  \u221e",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00637",
   "type": "text",
   "x": 37315,
   "y": 772,
   "width": 633.36,
   "height": 26.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00599",
   "roundness": null,
   "seed": 1341421,
   "version": 1,
   "versionNonce": 120082,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "the loss is not large. it is undefined. the metric breaks.",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the loss is not large. it is undefined. the metric breaks.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00638",
   "type": "rectangle",
   "x": 38080,
   "y": 220,
   "width": 620,
   "height": 300,
   "angle": 0,
   "strokeColor": "#1e1e1e",
