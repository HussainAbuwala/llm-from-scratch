   "versionNonce": 123168,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00639",
   "type": "text",
   "x": 38110,
   "y": 250,
   "width": 436.80000000000007,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00599",
   "roundness": null,
   "seed": 1345329,
   "version": 1,
   "versionNonce": 126254,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Zero is a very strong claim.",
   "fontSize": 30,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Zero is a very strong claim.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00640",
   "type": "text",
   "x": 38110,
   "y": 305,
   "width": 434.72,
   "height": 165.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00599",
   "roundness": null,
   "seed": 1347283,
   "version": 1,
   "versionNonce": 129340,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "The model is asserting that  a \u2192 x  is\nIMPOSSIBLE, on the evidence of a\nfew hundred names.\n\nNot observing something in a small\nsample is not proof it can't happen.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The model is asserting that  a \u2192 x  is\nIMPOSSIBLE, on the evidence of a\nfew hundred names.\n\nNot observing something in a small\nsample is not proof it can't happen.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00641",
   "type": "text",
   "x": 38080,
   "y": 570,
   "width": 366.08000000000004,
   "height": 165.0,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00599",
   "roundness": null,
   "seed": 1349237,
   "version": 1,
   "versionNonce": 132426,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "This is the maximum-likelihood\nestimate being too confident.\n\nWhich means the fix has to\ndeliberately move AWAY from\nthe maximum-likelihood estimate.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "This is the maximum-likelihood\nestimate being too confident.\n\nWhich means the fix has to\ndeliberately move AWAY from\nthe maximum-likelihood estimate.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "fram_00642",
   "type": "frame",
   "x": 39060,
   "y": 0,
   "width": 1600,
   "height": 900,
   "angle": 0,
   "strokeColor": "#bbb",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
