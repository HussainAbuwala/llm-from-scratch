   "roundness": null,
   "seed": 874415,
   "version": 1,
   "versionNonce": 1382528,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "If  a \u2192 n  is the biggest thing after a,\nand n \u2192 a  is the biggest thing after n,\nthen there is no way out. Ever.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "If  a \u2192 n  is the biggest thing after a,\nand n \u2192 a  is the biggest thing after n,\nthen there is no way out. Ever.",
   "autoResize": true,
   "lineHeight": 1.25
  },
