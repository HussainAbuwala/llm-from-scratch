  },
  {
   "id": "text_00583",
   "type": "text",
   "x": 33600,
   "y": 622,
   "width": 1212.12,
   "height": 26.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00564",
   "roundness": null,
   "seed": 1235905,
   "version": 1,
   "versionNonce": 1953438,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Build the model with an enormous smoothing value and it must land on ln(V+1). If it doesn't, the code is wrong.",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Build the model with an enormous smoothing value and it must land on ln(V+1). If it doesn't, the code is wrong.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00584",
   "type": "text",
   "x": 33570,
   "y": 730,
   "width": 761.28,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00564",
   "roundness": null,
   "seed": 1237859,
   "version": 1,
   "versionNonce": 1956524,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Two names for this same number, which you'll meet everywhere:",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two names for this same number, which you'll meet everywhere:",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00585",
   "type": "text",
   "x": 33570,
   "y": 780,
   "width": 1123.2,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00564",
   "roundness": null,
   "seed": 1239813,
   "version": 1,
   "versionNonce": 1959610,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "cross-entropy = average NLL in nats        perplexity = exp(average NLL)",
   "fontSize": 26,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "cross-entropy = average NLL in nats        perplexity = exp(average NLL)",
   "autoResize": true,
   "lineHeight": 1.25
  },
