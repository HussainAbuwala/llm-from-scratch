   "version": 1,
   "versionNonce": 336102,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "We added k to A cells, so the total grew by k \u00d7 A.\nForget it and your rows won't sum to 1 \u2014 this is the\nfirst thing to check when a table misbehaves.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "We added k to A cells, so the total grew by k \u00d7 A.\nForget it and your rows won't sum to 1 \u2014 this is the\nfirst thing to check when a table misbehaves.",
   "autoResize": true,
   "lineHeight": 1.25
  },
