   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "P(<END> | a) fell from 0.500 to 0.375.\nProbability given to the unseen has to be\ntaken from the seen. That is the trade.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "P(<END> | a) fell from 0.500 to 0.375.\nProbability given to the unseen has to be\ntaken from the seen. That is the trade.",
