   "roundness": null,
   "seed": 934989,
   "version": 1,
   "versionNonce": 1478194,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Greedy shows you one path through it. Sampling exposes\nthe whole distribution \u2014 including the parts that are wrong.\n\nFix the seed and any single run becomes reproducible.\n\n(temperature, top-k, top-p: later. Same idea, more dials.)",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Greedy shows you one path through it. Sampling exposes\nthe whole distribution \u2014 including the parts that are wrong.\n\nFix the seed and any single run becomes reproducible.\n\n(temperature, top-k, top-p: later. Same idea, more dials.)",
   "autoResize": true,
   "lineHeight": 1.25
  },
