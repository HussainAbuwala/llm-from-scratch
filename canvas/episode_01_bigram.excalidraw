   "link": null,
   "locked": false
  },
  {
   "id": "text_00784",
   "type": "text",
   "x": 46620,
   "y": 598,
   "width": 577.2,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00773",
   "roundness": null,
   "seed": 1628659,
   "version": 1,
   "versionNonce": 573724,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "This is the real lesson of episode 1.",
   "fontSize": 30,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "This is the real lesson of episode 1.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00785",
   "type": "text",
   "x": 46620,
   "y": 655,
   "width": 1135.68,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00773",
   "roundness": null,
   "seed": 1630613,
   "version": 1,
   "versionNonce": 576810,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "The model can make every neighbouring pair plausible and still produce something with no\nshape at all. Local correctness does not compose into global coherence \u2014 and it never will,\nfor a model whose entire memory is one character wide.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The model can make every neighbouring pair plausible and still produce something with no\nshape at all. Local correctness does not compose into global coherence \u2014 and it never will,\nfor a model whose entire memory is one character wide.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00786",
   "type": "text",
   "x": 46620,
   "y": 790,
   "width": 1121.1200000000001,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00773",
   "roundness": null,
   "seed": 1632567,
   "version": 1,
   "versionNonce": 579896,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "It also has no representation of meaning, and cannot transfer anything it learns about 'a' to 'e'.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It also has no representation of meaning, and cannot transfer anything it learns about 'a' to 'e'.",
   "autoResize": true,
   "lineHeight": 1.25
  },
