   "link": null,
   "locked": false,
   "text": "Sampling shows you the model you actually built.",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Sampling shows you the model you actually built.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00429",
   "type": "text",
   "x": 23150,
   "y": 560,
   "width": 655.2,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
