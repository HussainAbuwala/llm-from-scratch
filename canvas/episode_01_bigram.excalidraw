   "y": 0,
   "width": 1600,
   "height": 900,
   "angle": 0,
   "strokeColor": "#bbb",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
