   "locked": false,
   "text": "We need one number that we cannot flatter ourselves with.",
   "fontSize": 30,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "We need one number that we cannot flatter ourselves with.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00442",
   "type": "text",
   "x": 24330,
   "y": 762,
   "width": 983.8400000000001,
   "height": 55.0,
   "angle": 0,
   "strokeColor": "#868e96",
