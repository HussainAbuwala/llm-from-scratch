   "seed": 1106941,
   "version": 1,
   "versionNonce": 1749762,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "10\u00b3 = 1000        \u2192        log\u2081\u2080(1000) = 3",
   "fontSize": 28,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "10\u00b3 = 1000        \u2192        log\u2081\u2080(1000) = 3",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00518",
   "type": "text",
   "x": 29875,
   "y": 570,
   "width": 488.8,
   "height": 50.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
