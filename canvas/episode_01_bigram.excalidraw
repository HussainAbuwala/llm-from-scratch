   "locked": false
  },
  {
   "id": "text_00748",
   "type": "text",
   "x": 42900,
   "y": 678,
   "width": 640.64,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
