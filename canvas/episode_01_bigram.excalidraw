   "roundness": null,
   "seed": 430857,
   "version": 1,
   "versionNonce": 682006,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Slide a two-token window across the sequence and write down what you see.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Slide a two-token window across the sequence and write down what you see.",
