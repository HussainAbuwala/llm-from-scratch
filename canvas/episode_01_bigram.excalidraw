   "locked": false,
   "text": "<END> owns two of the four tickets,\nso P(<END> | a) = 0.50",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "<END> owns two of the four tickets,\nso P(<END> | a) = 0.50",
