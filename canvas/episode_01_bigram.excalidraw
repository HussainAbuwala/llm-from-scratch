   "versionNonce": 1518312,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "It has to be computed on text the model never trained on, and it has to consider every\nprediction \u2014 not the four I happened to like.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It has to be computed on text the model never trained on, and it has to consider every\nprediction \u2014 not the four I happened to like.",
   "autoResize": true,
   "lineHeight": 1.25
  },
