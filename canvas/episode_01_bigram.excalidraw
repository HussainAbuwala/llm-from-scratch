  },
  {
   "id": "text_00167",
   "type": "text",
   "x": 9450,
   "y": 784,
   "width": 1006.7200000000001,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00143",
   "roundness": null,
   "seed": 423041,
   "version": 1,
   "versionNonce": 669662,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Without it the model can only answer \"what comes next?\" \u2014 never \"that's the whole name.\"",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Without it the model can only answer \"what comes next?\" \u2014 never \"that's the whole name.\"",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00168",
   "type": "text",
   "x": 9450,
   "y": 820,
   "width": 915.2,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00143",
   "roundness": null,
   "seed": 424995,
   "version": 1,
   "versionNonce": 672748,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "P(\"anna\") would then mean P(anything starting with \"anna\") \u2014 annabelle included.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "P(\"anna\") would then mean P(anything starting with \"anna\") \u2014 annabelle included.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
