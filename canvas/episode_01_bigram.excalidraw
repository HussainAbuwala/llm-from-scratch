   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "the one rule that matters:",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the one rule that matters:",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00521",
   "type": "text",
   "x": 29875,
   "y": 742,
   "width": 570.0,
   "height": 31.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00509",
   "roundness": null,
   "seed": 1114757,
   "version": 1,
   "versionNonce": 1762106,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "log(a \u00d7 b \u00d7 c) = log a + log b + log c",
   "fontSize": 25,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "log(a \u00d7 b \u00d7 c) = log a + log b + log c",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00522",
   "type": "text",
   "x": 29875,
   "y": 795,
   "width": 457.6,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00509",
   "roundness": null,
   "seed": 1116711,
   "version": 1,
   "versionNonce": 1765192,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "an unstable product becomes a manageable sum",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "an unstable product becomes a manageable sum",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00523",
   "type": "text",
   "x": 30550,
