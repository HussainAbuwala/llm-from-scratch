   "locked": false
  },
  {
   "id": "text_00401",
   "type": "text",
   "x": 21286,
   "y": 492,
   "width": 582.4,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00378",
   "roundness": null,
   "seed": 880277,
   "version": 1,
   "versionNonce": 1391786,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Greedy is not wrong, it is short-sighted",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Greedy is not wrong, it is short-sighted",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00402",
   "type": "text",
   "x": 21286,
   "y": 544,
   "width": 520.0,
   "height": 175.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00378",
   "roundness": null,
   "seed": 882231,
   "version": 1,
   "versionNonce": 1394872,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "It picks the best next token, which is not the\nsame as the best sequence. It will never take a\nlower-probability exit like  a \u2192 <END>,  even when\nthat exit is the only sane move.\n\nIt is deterministic and reproducible, which is\ngenuinely useful \u2014 just not here.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It picks the best next token, which is not the\nsame as the best sequence. It will never take a\nlower-probability exit like  a \u2192 <END>,  even when\nthat exit is the only sane move.\n\nIt is deterministic and reproducible, which is\ngenuinely useful \u2014 just not here.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00403",
   "type": "text",
   "x": 21440,
   "y": 232,
   "width": 331.76000000000005,
   "height": 55.0,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00378",
   "roundness": null,
   "seed": 884185,
   "version": 1,
   "versionNonce": 1397958,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "(illustration \u2014 a constructed\nloop, so the trap is visible)",
   "fontSize": 22,
   "fontFamily": 1,
