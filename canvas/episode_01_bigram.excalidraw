   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00064",
   "roundness": null,
   "seed": 292123,
   "version": 1,
   "versionNonce": 462900,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "The definition never changes: the vocabulary is the set of distinct token types.",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The definition never changes: the vocabulary is the set of distinct token types.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00101",
   "type": "text",
   "x": 5690,
   "y": 754,
   "width": 334.88,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00064",
   "roundness": null,
   "seed": 294077,
   "version": 1,
   "versionNonce": 465986,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Only the tokens change.",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Only the tokens change.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00102",
   "type": "text",
   "x": 5690,
   "y": 800,
   "width": 1223.04,
   "height": 26.25,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00064",
   "roundness": null,
   "seed": 296031,
   "version": 1,
   "versionNonce": 469072,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Ours: the letters in the name list, plus two boundary tokens. 26 letters + <END> = 27 things that can come next.",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Ours: the letters in the name list, plus two boundary tokens. 26 letters + <END> = 27 things that can come next.",
   "autoResize": true,
   "lineHeight": 1.25
  },
