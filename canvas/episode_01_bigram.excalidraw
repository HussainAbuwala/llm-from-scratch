   "seed": 1550499,
   "version": 1,
   "versionNonce": 450284,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "\u00f8  is not in the vocabulary\nat all",
   "fontSize": 26,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u00f8  is not in the vocabulary\nat all",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00745",
   "type": "text",
   "x": 43660,
   "y": 460,
   "width": 308.88000000000005,
   "height": 82.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00735",
   "roundness": null,
   "seed": 1552453,
   "version": 1,
   "versionNonce": 453370,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "There is no row, no column,\nand no integer ID.\nThere is nothing to smooth.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "There is no row, no column,\nand no integer ID.\nThere is nothing to smooth.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00746",
   "type": "text",
   "x": 43660,
   "y": 560,
   "width": 378.56,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00735",
   "roundness": null,
   "seed": 1554407,
   "version": 1,
   "versionNonce": 456456,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "\u2192 that's a tokenizer problem",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2192 that's a tokenizer problem",
   "autoResize": true,
   "lineHeight": 1.25
  },
