   "versionNonce": 107738,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "P(word) = 0.6 \u00d7 0.2 \u00d7 0.00 \u00d7 0.4  =  0",
   "fontSize": 26,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "P(word) = 0.6 \u00d7 0.2 \u00d7 0.00 \u00d7 0.4  =  0",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00634",
   "type": "text",
   "x": 37315,
   "y": 590,
   "width": 524.16,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00599",
   "roundness": null,
   "seed": 1335559,
   "version": 1,
   "versionNonce": 110824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "one zero anywhere destroys the entire sequence \u2014\nthat's what multiplying means",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "one zero anywhere destroys the entire sequence \u2014\nthat's what multiplying means",
   "autoResize": true,
   "lineHeight": 1.25
  },
