  },
  {
   "id": "text_00707",
   "type": "text",
   "x": 39965,
   "y": 510,
   "width": 540.8000000000001,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
