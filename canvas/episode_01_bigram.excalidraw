   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "a \u2192 n  and  n \u2192 a  are different observations,\nstored in different cells. Never merge them.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "a \u2192 n  and  n \u2192 a  are different observations,\nstored in different cells. Never merge them.",
   "autoResize": true,
   "lineHeight": 1.25
  },
