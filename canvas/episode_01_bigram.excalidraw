   "roundness": null,
   "seed": 1103033,
   "version": 1,
   "versionNonce": 1743590,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "A logarithm asks: what exponent produces this number?",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A logarithm asks: what exponent produces this number?",
