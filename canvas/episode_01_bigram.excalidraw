   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Almost every one of those rows would be empty or near-empty. More context makes the table\nsparser and the zeros worse. Counting cannot be the answer.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Almost every one of those rows would be empty or near-empty. More context makes the table\nsparser and the zeros worse. Counting cannot be the answer.",
   "autoResize": true,
   "lineHeight": 1.25
  },
