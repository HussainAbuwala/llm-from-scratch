   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "How can a model use MORE context, and share what it learns between\nsimilar contexts, without storing a separate number for every\npossible history?",
   "fontSize": 34,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "How can a model use MORE context, and share what it learns between\nsimilar contexts, without storing a separate number for every\npossible history?",
   "autoResize": true,
