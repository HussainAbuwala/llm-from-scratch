   "versionNonce": 135512,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "name": "22 \u00b7 Add-k smoothing"
  },
  {
   "id": "text_00643",
   "type": "text",
   "x": 39130,
   "y": 52,
   "width": 1196.0,
   "height": 57.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00642",
   "roundness": null,
   "seed": 1353145,
   "version": 1,
   "versionNonce": 138598,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Give every possible transition a small head start.",
   "fontSize": 46,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Give every possible transition a small head start.",
