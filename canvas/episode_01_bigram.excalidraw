  },
  {
   "id": "text_00590",
   "type": "text",
   "x": 35490,
   "y": 340,
   "width": 399.36,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
