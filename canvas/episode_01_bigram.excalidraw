   "versionNonce": 589154,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "A trigram model can tell 'ma' from 'pa'. Now count the rows you need.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A trigram model can tell 'ma' from 'pa'. Now count the rows you need.",
