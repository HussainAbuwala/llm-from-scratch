   "version": 1,
   "versionNonce": 1867030,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "confident and right \u2192 nearly free.   confident and wrong \u2192 expensive.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "confident and right \u2192 nearly free.   confident and wrong \u2192 expensive.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00556",
   "type": "rectangle",
   "x": 32500,
   "y": 210,
   "width": 630,
   "height": 250,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#a5d8ff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00530",
   "roundness": {
    "type": 3
   },
   "seed": 1183147,
   "version": 1,
   "versionNonce": 1870116,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00557",
   "type": "text",
   "x": 32526,
   "y": 232,
   "width": 262.08,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00530",
   "roundness": null,
   "seed": 1185101,
   "version": 1,
   "versionNonce": 1873202,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Why negate at all?",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why negate at all?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00558",
   "type": "text",
   "x": 32526,
   "y": 284,
   "width": 502.32,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00530",
   "roundness": null,
   "seed": 1187055,
   "version": 1,
   "versionNonce": 1876288,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Because 'higher likelihood is better' and\n'lower loss is better' are the same statement,\nand every optimiser we meet from episode 3\nonwards is built to push a number DOWN.",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Because 'higher likelihood is better' and\n'lower loss is better' are the same statement,\nand every optimiser we meet from episode 3\nonwards is built to push a number DOWN.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00559",
   "type": "rectangle",
   "x": 32500,
   "y": 490,
   "width": 630,
   "height": 200,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#b2f2bb",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00530",
   "roundness": {
    "type": 3
   },
   "seed": 1189009,
   "version": 1,
   "versionNonce": 1879374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00560",
   "type": "text",
   "x": 32526,
   "y": 512,
   "width": 174.72,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00530",
   "roundness": null,
   "seed": 1190963,
   "version": 1,
   "versionNonce": 1882460,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Why average?",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why average?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00561",
   "type": "text",
   "x": 32526,
   "y": 564,
   "width": 513.24,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00530",
   "roundness": null,
   "seed": 1192917,
   "version": 1,
   "versionNonce": 1885546,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Total NLL grows with the amount of text.\n1000 predictions accrue ~10\u00d7 the penalty of 100\nat identical quality. Divide by the number of\ntransitions and lengths become comparable.",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Total NLL grows with the amount of text.\n1000 predictions accrue ~10\u00d7 the penalty of 100\nat identical quality. Divide by the number of\ntransitions and lengths become comparable.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00562",
   "type": "text",
   "x": 32500,
   "y": 720,
   "width": 577.1999999999999,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00530",
   "roundness": null,
   "seed": 1194871,
   "version": 1,
   "versionNonce": 1888632,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "avg NLL = total penalty \u00f7 transitions",
   "fontSize": 26,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "avg NLL = total penalty \u00f7 transitions",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00563",
   "type": "text",
   "x": 32500,
   "y": 780,
   "width": 549.1200000000001,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00530",
   "roundness": null,
   "seed": 1196825,
   "version": 1,
   "versionNonce": 1891718,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "\"on a typical prediction, how surprised was it?\"",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\"on a typical prediction, how surprised was it?\"",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "fram_00564",
   "type": "frame",
   "x": 33480,
   "y": 0,
   "width": 1600,
   "height": 900,
   "angle": 0,
   "strokeColor": "#bbb",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1198779,
   "version": 1,
   "versionNonce": 1894804,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "name": "19 \u00b7 Lower than what?"
  },
  {
   "id": "text_00565",
   "type": "text",
   "x": 33550,
   "y": 52,
   "width": 1148.16,
   "height": 57.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00564",
   "roundness": null,
   "seed": 1200733,
   "version": 1,
   "versionNonce": 1897890,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "An average NLL of 2.4 is meaningless on its own.",
   "fontSize": 46,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "An average NLL of 2.4 is meaningless on its own.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00566",
   "type": "text",
   "x": 33550,
   "y": 116,
   "width": 985.9200000000001,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00564",
   "roundness": null,
   "seed": 1202687,
   "version": 1,
   "versionNonce": 1900976,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "A loss only means something next to a reference point. So build two bad models.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A loss only means something next to a reference point. So build two bad models.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
