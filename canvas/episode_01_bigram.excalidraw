   "text": "a neural network starts from\nrandom numbers and crawls\ntoward that same loss,\none gradient step at a time.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "a neural network starts from\nrandom numbers and crawls\ntoward that same loss,\none gradient step at a time.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00596",
