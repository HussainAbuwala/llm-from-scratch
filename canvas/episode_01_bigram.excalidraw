  {
   "id": "text_00056",
   "type": "text",
   "x": 4560,
   "y": 450,
   "width": 228.8,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00037",
   "roundness": null,
   "seed": 206147,
   "version": 1,
   "versionNonce": 327116,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "4 tokens, not 1 word",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4 tokens, not 1 word",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00057",
   "type": "text",
   "x": 4560,
   "y": 490,
   "width": 312.0,
   "height": 50.0,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00037",
   "roundness": null,
   "seed": 208101,
   "version": 1,
   "versionNonce": 330202,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "\u2014 next scene: what that set of\n   tokens is called",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u2014 next scene: what that set of\n   tokens is called",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00058",
   "type": "rectangle",
   "x": 3800,
   "y": 612,
   "width": 1000,
   "height": 246,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#d0bfff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00037",
   "roundness": {
    "type": 3
   },
   "seed": 210055,
   "version": 1,
   "versionNonce": 333288,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00059",
   "type": "text",
   "x": 3826,
   "y": 634,
   "width": 422.24,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00037",
   "roundness": null,
   "seed": 212009,
   "version": 1,
   "versionNonce": 336374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Why one character of context?",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why one character of context?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00060",
   "type": "text",
   "x": 3826,
   "y": 686,
   "width": 633.36,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00037",
   "roundness": null,
   "seed": 213963,
   "version": 1,
   "versionNonce": 339460,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Because every number stays checkable by hand \u2014 which is\nhow we catch the code lying.\n\nThis is the Markov assumption, first order: the next token\ndepends only on the last one. It is the strongest\nsimplification here, and the one episode 2 goes after.",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Because every number stays checkable by hand \u2014 which is\nhow we catch the code lying.\n\nThis is the Markov assumption, first order: the next token\ndepends only on the last one. It is the strongest\nsimplification here, and the one episode 2 goes after.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00061",
   "type": "rectangle",
   "x": 4840,
   "y": 612,
   "width": 400,
   "height": 252,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffec99",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "dashed",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00037",
   "roundness": {
    "type": 3
   },
   "seed": 215917,
   "version": 1,
   "versionNonce": 342546,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00062",
   "type": "text",
   "x": 4866,
   "y": 630,
   "width": 202.79999999999998,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00037",
   "roundness": null,
   "seed": 217871,
   "version": 1,
   "versionNonce": 345632,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Who was Markov?",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Who was Markov?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00063",
   "type": "text",
   "x": 4866,
   "y": 672,
   "width": 299.52,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00037",
   "roundness": null,
   "seed": 219825,
   "version": 1,
   "versionNonce": 348718,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Andrey Markov, 1856\u20131922.\n\nIn 1913 he counted vowel and\nconsonant transitions across\n20,000 letters of Eugene Onegin.\nBy hand.\nThe first one was a character\nbigram model, same as ours.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Andrey Markov, 1856\u20131922.\n\nIn 1913 he counted vowel and\nconsonant transitions across\n20,000 letters of Eugene Onegin.\nBy hand.\nThe first one was a character\nbigram model, same as ours.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "fram_00064",
   "type": "frame",
   "x": 5580,
   "y": 0,
   "width": 1600,
   "height": 900,
   "angle": 0,
   "strokeColor": "#bbb",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 221779,
   "version": 1,
   "versionNonce": 351804,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "name": "04 \u00b7 What \"vocabulary\" means"
  },
  {
   "id": "text_00065",
   "type": "text",
   "x": 5650,
   "y": 52,
   "width": 837.2,
   "height": 57.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00064",
   "roundness": null,
   "seed": 223733,
   "version": 1,
   "versionNonce": 354890,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Vocabulary: the set of token types.",
   "fontSize": 46,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Vocabulary: the set of token types.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00066",
   "type": "text",
   "x": 5650,
   "y": 116,
   "width": 1098.24,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00064",
   "roundness": null,
   "seed": 225687,
   "version": 1,
   "versionNonce": 357976,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Not the names \u2014 those are the data. The vocabulary is what the model is allowed to emit.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not the names \u2014 those are the data. The vocabulary is what the model is allowed to emit.",
   "autoResize": true,
   "lineHeight": 1.25
  },
