   "versionNonce": 1975040,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "is not just *a* reasonable\nway to get probabilities.\n\nIt is the EXACT minimiser of\naverage NLL on the training set.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "is not just *a* reasonable\nway to get probabilities.\n\nIt is the EXACT minimiser of\naverage NLL on the training set.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00591",
   "type": "text",
   "x": 35460,
   "y": 520,
   "width": 648.96,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00586",
   "roundness": null,
   "seed": 1251537,
   "version": 1,
   "versionNonce": 1978126,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "No bigram table scores better on this training data.\nWe found it in one pass, with no optimiser.",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "No bigram table scores better on this training data.\nWe found it in one pass, with no optimiser.",
   "autoResize": true,
   "lineHeight": 1.25
  },
