   "version": 1,
   "versionNonce": 1752848,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "ln uses base e \u2248 2.718. Base changes the scale,\nnever which model wins.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ln uses base e \u2248 2.718. Base changes the scale,\nnever which model wins.",
   "autoResize": true,
   "lineHeight": 1.25
  },
