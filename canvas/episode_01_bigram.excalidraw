   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Normalising rescales but\npreserves proportion:\n<END> happened twice as\noften as n, and stays\ntwice as likely.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Normalising rescales but\npreserves proportion:\n<END> happened twice as\noften as n, and stays\ntwice as likely.",
