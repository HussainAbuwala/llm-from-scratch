   "text": "current\ntoken",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "current\ntoken",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00292",
   "type": "text",
   "x": 15180,
   "y": 570,
   "width": 789.3600000000001,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00237",
   "roundness": null,
   "seed": 667291,
   "version": 1,
   "versionNonce": 1055412,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "each cell:  how many times did the column token follow the row token?",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "each cell:  how many times did the column token follow the row token?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00293",
   "type": "rectangle",
   "x": 14970,
   "y": 640,
   "width": 700,
   "height": 210,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00237",
   "roundness": {
    "type": 3
   },
   "seed": 669245,
   "version": 1,
   "versionNonce": 1058498,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00294",
   "type": "text",
   "x": 14996,
   "y": 662,
   "width": 596.96,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00237",
   "roundness": null,
   "seed": 671199,
   "version": 1,
   "versionNonce": 1061584,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "The rows and columns are NOT the same set",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The rows and columns are NOT the same set",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00295",
   "type": "text",
   "x": 14996,
   "y": 714,
   "width": 707.2,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00237",
   "roundness": null,
   "seed": 673153,
   "version": 1,
   "versionNonce": 1064670,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "<START>  is a row, never a column   \u2014 nothing is followed BY a start\n<END>    is a column, never a row   \u2014 nothing follows an end\nordinary characters are both",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "<START>  is a row, never a column   \u2014 nothing is followed BY a start\n<END>    is a column, never a row   \u2014 nothing follows an end\nordinary characters are both",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00296",
   "type": "rectangle",
   "x": 15710,
   "y": 640,
   "width": 680,
   "height": 210,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#d0bfff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00237",
   "roundness": {
    "type": 3
   },
   "seed": 675107,
   "version": 1,
   "versionNonce": 1067756,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00297",
   "type": "text",
   "x": 15736,
   "y": 662,
   "width": 422.24,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00237",
   "roundness": null,
   "seed": 677061,
   "version": 1,
   "versionNonce": 1070842,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "So the shape is (V+1) \u00d7 (V+1)",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "So the shape is (V+1) \u00d7 (V+1)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00298",
   "type": "text",
   "x": 15736,
   "y": 714,
   "width": 592.8000000000001,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00237",
   "roundness": null,
   "seed": 679015,
   "version": 1,
   "versionNonce": 1073928,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "and \u2014 this matters in a minute \u2014 every cell in it is a\ntransition that is at least POSSIBLE.\nWhen we add pseudo-counts, those are the cells we add to.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "and \u2014 this matters in a minute \u2014 every cell in it is a\ntransition that is at least POSSIBLE.\nWhen we add pseudo-counts, those are the cells we add to.",
   "autoResize": true,
   "lineHeight": 1.25
  },
