  },
  {
   "id": "text_00633",
   "type": "text",
   "x": 37315,
   "y": 534,
   "width": 592.8,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
