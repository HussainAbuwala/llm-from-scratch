   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Choosing is a separate decision\nfrom predicting.\n\nWe'll make it two different ways\nlater in this episode, from the\nsame numbers.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Choosing is a separate decision\nfrom predicting.\n\nWe'll make it two different ways\nlater in this episode, from the\nsame numbers.",
   "autoResize": true,
   "lineHeight": 1.25
  },
