   "locked": false
  },
  {
   "id": "text_00597",
   "type": "text",
   "x": 35490,
   "y": 668,
   "width": 742.5600000000001,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00586",
   "roundness": null,
   "seed": 1263261,
   "version": 1,
   "versionNonce": 1996642,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "So here is the test that ties this series together:",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "So here is the test that ties this series together:",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00598",
   "type": "text",
   "x": 35490,
   "y": 718,
   "width": 1004.64,
   "height": 78.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00586",
   "roundness": null,
   "seed": 1265215,
   "version": 1,
   "versionNonce": 1999728,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "when we train the neural bigram model in episode 3, it should converge to roughly the number\nwe just got for free. If it doesn't, the training code is broken \u2014 and we'll know, because\ntoday gave us the answer key.",
   "fontSize": 21,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "when we train the neural bigram model in episode 3, it should converge to roughly the number\nwe just got for free. If it doesn't, the training code is broken \u2014 and we'll know, because\ntoday gave us the answer key.",
   "autoResize": true,
   "lineHeight": 1.25
  },
