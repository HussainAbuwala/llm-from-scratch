   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "name": "07 \u00b7 The sliding window"
  },
  {
   "id": "text_00170",
   "type": "text",
   "x": 11230,
   "y": 52,
   "width": 1124.24,
   "height": 57.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00169",
   "roundness": null,
   "seed": 428903,
   "version": 1,
   "versionNonce": 678920,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Training data is not text. It is ordered pairs.",
   "fontSize": 46,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Training data is not text. It is ordered pairs.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00171",
   "type": "text",
