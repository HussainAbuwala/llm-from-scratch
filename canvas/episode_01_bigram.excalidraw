   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "now suppose held-out data contains  a \u2192 x",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "now suppose held-out data contains  a \u2192 x",
   "autoResize": true,
   "lineHeight": 1.25
  },
