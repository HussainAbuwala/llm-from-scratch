   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00506",
   "type": "text",
   "x": 28826,
   "y": 252,
   "width": 538.72,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00487",
   "roundness": null,
   "seed": 1085447,
   "version": 1,
   "versionNonce": 1715816,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "This is the chain rule of probability",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "This is the chain rule of probability",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00507",
   "type": "text",
   "x": 28826,
   "y": 304,
   "width": 478.40000000000003,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00487",
   "roundness": null,
   "seed": 1087401,
   "version": 1,
   "versionNonce": 1718902,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "P(A then B)  =  P(A) \u00d7 P(B | A)\n\nWe are NOT multiplying unrelated numbers.\nEvery factor is conditional on where the\nprevious step left us.\n\nBigram model = chain rule + Markov assumption:\nkeep the product, but let each factor see\nonly one token back.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "P(A then B)  =  P(A) \u00d7 P(B | A)\n\nWe are NOT multiplying unrelated numbers.\nEvery factor is conditional on where the\nprevious step left us.\n\nBigram model = chain rule + Markov assumption:\nkeep the product, but let each factor see\nonly one token back.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00508",
   "type": "text",
   "x": 28800,
   "y": 570,
   "width": 331.76000000000005,
   "height": 192.5,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00487",
   "roundness": null,
   "seed": 1089355,
   "version": 1,
   "versionNonce": 1721988,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Each multiplication takes a\nfraction of whatever survived\nthe step before it.\n\nWhich is exactly why long\nsequences end up with\nabsurdly small numbers.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each multiplication takes a\nfraction of whatever survived\nthe step before it.\n\nWhich is exactly why long\nsequences end up with\nabsurdly small numbers.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "fram_00509",
   "type": "frame",
