   "roundness": null,
   "seed": 1558315,
   "version": 1,
   "versionNonce": 462628,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "What smoothing actually changes is a belief:",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "What smoothing actually changes is a belief:",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00749",
   "type": "text",
   "x": 42900,
   "y": 730,
   "width": 739.2,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00735",
   "roundness": null,
   "seed": 1560269,
   "version": 1,
   "versionNonce": 465714,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "from   \"unseen means impossible\"\nto     \"unseen means unlikely, but possible\"",
   "fontSize": 28,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "from   \"unseen means impossible\"\nto     \"unseen means unlikely, but possible\"",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00750",
   "type": "text",
