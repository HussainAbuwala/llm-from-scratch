   "versionNonce": 580168,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Where does the vocabulary come from?",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Where does the vocabulary come from?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00139",
   "type": "text",
   "x": 8086,
   "y": 534,
   "width": 759.2,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00103",
   "roundness": null,
   "seed": 368329,
   "version": 1,
   "versionNonce": 583254,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "From the TRAINING split only \u2014 never the whole file.\nIf held-out data contains a character we never trained on, we have no row\nfor it. We report that rather than hide it. (Real fix: <UNK>, or bytes.)",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "From the TRAINING split only \u2014 never the whole file.\nIf held-out data contains a character we never trained on, we have no row\nfor it. We report that rather than hide it. (Real fix: <UNK>, or bytes.)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00140",
   "type": "text",
   "x": 8060,
   "y": 690,
   "width": 663.5200000000001,
   "height": 82.5,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "fram_00103",
   "roundness": null,
   "seed": 370283,
   "version": 1,
   "versionNonce": 586340,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "<START> and <END> are not characters in any name.\nThey are tokens we invent, and the model has to learn them\nlike everything else. Next scene explains why they exist.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "<START> and <END> are not characters in any name.\nThey are tokens we invent, and the model has to learn them\nlike everything else. Next scene explains why they exist.",
   "autoResize": true,
   "lineHeight": 1.25
  },
