   "link": null,
   "locked": false,
   "text": "That sounds almost useless.\n\nIt is also the smallest thing\nthat is honestly a language model \u2014\nwhich makes it the only place\nto start.",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "That sounds almost useless.\n\nIt is also the smallest thing\nthat is honestly a language model \u2014\nwhich makes it the only place\nto start.",
   "autoResize": true,
   "lineHeight": 1.25
  },
