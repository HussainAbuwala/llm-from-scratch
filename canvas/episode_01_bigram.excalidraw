   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Every occurrence of\nevery character produces\nexactly one outgoing\ntransition \u2014 because\nof <END>.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every occurrence of\nevery character produces\nexactly one outgoing\ntransition \u2014 because\nof <END>.",
