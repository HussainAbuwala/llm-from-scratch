   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "A better training fit can reject a held-out spelling. Trigram NLL is infinite here.",
   "fontSize": 30,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rect_00355",
   "originalText": "A better training fit can reject a held-out spelling. Trigram NLL is infinite here.",
   "autoResize": true,
   "lineHeight": 1.25
  },
