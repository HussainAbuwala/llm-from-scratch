      "isDeleted": false,
      "boundElements": [],
      "updated": 1790718158760,
      "link": null,
      "locked": false,
      "text": "It has to be computed on text the model never trained on, and it has to consider every\nprediction — not the four I happened to like.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It has to be computed on text the model never trained on, and it has to consider every\nprediction — not the four I happened to like.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b5s",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
