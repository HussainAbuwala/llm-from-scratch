   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "Each of these gets introduced from zero, in the episode that needs it,\nin the smallest form that does the job. If a symbol appears on screen,\nI have already said out loud what it means.",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each of these gets introduced from zero, in the episode that needs it,\nin the smallest form that does the job. If a symbol appears on screen,\nI have already said out loud what it means.",
   "autoResize": true,
   "lineHeight": 1.25
  },
