   "seed": 170975,
   "version": 1,
   "versionNonce": 271568,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "GPT-4 does this.\nOur first model does this.\n\nThe gap between them is\n40 years of engineering \u2014\nnot a different idea.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "GPT-4 does this.\nOur first model does this.\n\nThe gap between them is\n40 years of engineering \u2014\nnot a different idea.",
   "autoResize": true,
   "lineHeight": 1.25
  },
