   "boundElements": null,
   "updated": 1755000000000,
   "link": null,
   "locked": false,
   "text": "1.  Watch the theory video. Don't touch a keyboard.\n2.  Watch the build video with the editor open.\n3.  Answer the checkpoint questions from memory. If one of them stalls you,\n     that's the bit to rewatch \u2014 not the whole episode.",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1.  Watch the theory video. Don't touch a keyboard.\n2.  Watch the build video with the editor open.\n3.  Answer the checkpoint questions from memory. If one of them stalls you,\n     that's the bit to rewatch \u2014 not the whole episode.",
   "autoResize": true,
   "lineHeight": 1.25
  },
